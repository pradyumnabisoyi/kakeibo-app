{
  "expo": {
    "name": "Kakeibo",
    "slug": "Kakeibo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kakeibo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chatashali.kakeibo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#008E4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008E4B",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 150
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "adfc381b-c0dd-40fd-9a43-4f29f02d5d56"
      }
    }
  }
}